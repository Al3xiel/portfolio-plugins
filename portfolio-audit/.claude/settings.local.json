{
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/pa/pa.mjs:*)",
      "Bash(node */.claude/pa/pa.mjs exec --b64 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/pa/hooks/filter-output.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/pa/hooks/file-name-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
